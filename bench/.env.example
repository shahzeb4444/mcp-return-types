# Copy to bench/.env (never commit).
BENCH_BACKENDS=claude-cli,codex-cli   # which backends to run, comma separated
BENCH_CLAUDE_MODELS=claude-sonnet-5-5,claude-haiku-5-5   # exact IDs, never aliases (weak = claude-haiku-5-5)
BENCH_CODEX_MODELS=gpt-6.2-sol,gpt-6-luna   # strong, weak (verified in M6, see NOTES.md)
BENCH_CODEX_EFFORT=medium             # codex exec -c model_reasoning_effort=<low|medium|high>
BENCH_MAX_RUNS=500   # per-backend cap
BENCH_RATE_LIMIT_SLEEP_MIN=30
BENCH_MAX_WAIT_HOURS=24
# optional extras:
# BENCH_BACKEND_EXTRA=ollama
# ANTHROPIC_API_KEY / OPENAI_API_KEY: leave UNSET (they would switch the CLIs to paid API billing)
